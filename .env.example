# Copy to .env next to docker-compose.yml
FORGE_IMAGE_OWNER=your-github-user
FORGE_TAG=latest
TZ=America/Denver

# Public URL users open, e.g. https://forge.example.com (your tunnel hostname)
# Required for OIDC. Offline support and installing on a phone need HTTPS.
APP_URL=

# Host port, and which interface it listens on. With a tunnel/reverse proxy on
# the same host (e.g. cloudflared under systemd → http://localhost:3000), set
# FORGE_BIND=127.0.0.1 so Forge isn't reachable directly on the LAN.
FORGE_PORT=3000
FORGE_BIND=0.0.0.0

# ── Sign-in ───────────────────────────────────────────────────────────────────
# Leave everything below empty only for a LAN-only install. If Forge is
# reachable from the internet (e.g. via the tunnel), set OIDC_* or APP_PASSWORD.

# OIDC (multi-tenant). Register Forge as a client with redirect URI
#   ${APP_URL}/auth/callback   and post-logout redirect ${APP_URL}/login
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Omit for a public client (PKCE only)
OIDC_CLIENT_SECRET=
# Button label: "Sign in with <name>"
OIDC_PROVIDER_NAME=
# Optional allowlist: comma-separated emails and/or @domains
OIDC_ALLOWED_EMAILS=
# OIDC_SCOPES=openid profile email

# Passcode (single user), used only when OIDC is not configured
APP_PASSWORD=

# Optional: fixed session signing key (otherwise generated and stored in the DB)
# SESSION_SECRET=
# Override secure-cookie detection (defaults to true when APP_URL is https)
# COOKIE_SECURE=
